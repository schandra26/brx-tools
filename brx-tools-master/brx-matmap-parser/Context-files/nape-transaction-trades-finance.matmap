                        <repeatsMax>1</repeatsMax>
                        <value/>
                    </messageElement>
                    <messageElement>
                        <name>TIMESTAMP</name>
                        <mandatory>true</mandatory>
                        <repeatsMax>1</repeatsMax>
                        <value>$"TIMESTAMP"
$V(Tmp_Date,$"TIMESTAMP"{Substr:1:10})
$V(Tmp_CCYY,$"TIMESTAMP"{Substr:1:4})
$V(Tmp_Month,$"TIMESTAMP"{Substr:6:2})
$V(Tmp_Day,$"TIMESTAMP"{Substr:9:2})
$V(Tmp_HH,$"TIMESTAMP"{Substr:12:2})
$V(Tmp_MM,$"TIMESTAMP"{Substr:15:2})
$V(Tmp_SS,$"TIMESTAMP"{Substr:18:2})
$V(Tmp_mmm,$"TIMESTAMP"{Substr:21:3})
$V(Tmp_timestamp,$"Tmp_Date"T$"Tmp_HH":$"Tmp_MM":$"Tmp_SS"Z)
$V(TimeStamp,$"Tmp_CCYY"$"Tmp_Month"$"Tmp_Day"$"Tmp_HH"$"Tmp_MM"$"Tmp_SS"$"Tmp_mmm")
$V(BRx_TransactionVersion,$"TimeStamp")</value>
                    </messageElement>
                    <messageElement>
                        <name>BCUSP</name>
