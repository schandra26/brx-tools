<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<Translator xmlns="http://messageautomation.com/translator/v1/XMLSchema.xsd">
    <Messages>
        <message>
            <messageDefinition>
                <messageCategory>
                    <name>nape-transaction-finance-input</name>
                </messageCategory>
                <messageDetail>
                    <name>BRX_FINFILEP</name>
                    <type>XML</type>
                    <allowBlanks>false</allowBlanks>
                </messageDetail>
                <messageElement>
                    <name>feed</name>
                    <mandatory>true</mandatory>
                    <repeatsMax>1</repeatsMax>
                    <value>$V(BRx_TransactionClientIdentifier,$"Impact_TrailBlazer_ClientId"{Trim})
$V(BRx_TransactionOrigin,IMPACT)
$V(BRx_TransactionCategory,Financing)
$V(BRx_TransactionCountry,USA)

$V(BRx_TransactionPartyRole_count,,INC)
$V(BRx_TransactionPartyIdentifierType_$"BRx_TransactionPartyRole_count",Internal)
$V(BRx_TransactionPartyIdentifierValue_$"BRx_TransactionPartyRole_count",$"Impact_TrailBlazer_ClientId"{Trim})
$V(BRx_TransactionPartyRole_$"BRx_TransactionPartyRole_count",Organization)

</value>
                    <messageValue>
                        <suffix>xmlns:xsi</suffix>
                        <value>http://www.w3.org/2001/XMLSchema-instance</value>
                    </messageValue>
                    <messageValue>
                        <suffix>name</suffix>
                        <value>$"name"</value>
                        <mandatoryAttribute>true</mandatoryAttribute>
                    </messageValue>
                    <messageElement>
                        <name>RECORD_TYPE</name>
                        <mandatory>true</mandatory>
                        <repeatsMax>1</repeatsMax>
                        <value/>
                    </messageElement>
                    <messageElement>
                        <name>ID</name>
                        <mandatory>true</mandatory>
                        <repeatsMax>1</repeatsMax>
                        <value/>
                    </messageElement>
