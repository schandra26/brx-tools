$V(businessDate,20$"root_cmbl_bookkeep_last_act"{yy-MM-dd} $D{ISOTimeMillOff})

$V(BRx_BalanceBusinessDate,$"businessDate")

$V(BRx_BalanceFromDate,$"businessDate")
