            <messageDefinition>
                <messageCategory>
                    <name>IntradayBalances</name>
                </messageCategory>
                <messageDetail>
                    <name>IntradayBalanceInputT2</name>
                    <type>JSON</type>
                    <allowBlanks>false</allowBlanks>
                </messageDetail>
                <messageElement>
                    <name>root</name>
                    <javaObjectType>object</javaObjectType>
                    <value/>
                    <messageElement>
                        <name>CMBL_COMPANY_CODE</name>
                        <javaObjectType>number</javaObjectType>
                        <value>$"root_cmbl_company_code"

$V(BRx_BalanceClientIdentifier,$E(("000" + ($"root_cmbl_company_code" % 1000)).substring(("000" + ($"root_cmbl_company_code" % 1000)).length - 3)))
$V(BRx_BalanceEntity,$E(("000" + ($"root_cmbl_company_code" % 1000)).substring(("000" + ($"root_cmbl_company_code" % 1000)).length - 3)))

$V(BRx_BalanceOrigin,BPS)

$V(BRx_BalancePublishedDateTime,$D{ISODateTimeMillOff})
$V(BRx_BalanceLastUpdateDateTime,$D{ISODateTimeMillOff})

$?($"bps_version" != 1752482871,
$V(LogReaderTimestamp,$"A_TIMSTAMP"{Remove:-,:,., ,T,Z}{:5:23})
$V(bps_version,$"LogReaderTimestamp")
$V(BRx_BalanceVersion,$"bps_version"),
$V(BRx_BalanceVersion,$"bps_version"))

$V(BRx_BalanceFlagValue_IsRT,true)
$V(BRx_BalanceFlagValue_IsEOD,false)
$V(BRx_BalanceFlagValue_IsSOD,false)

$V(MessageReceivedTimestampDS,$D{ISODateTimeMill}Z)</value>
                    </messageElement>
                    <messageElement>
                        <name>CMBL_OFFICE_CODE</name>
                        <javaObjectType>number</javaObjectType>
                        <value>$"root_cmbl_office_code"

$V(branchCode,$E(("000" + ($"root_cmbl_office_code" % 1000)).substring(("000" + ($"root_cmbl_office_code" % 1000)).length - 3)))</value>
                    </messageElement>
                    <messageElement>
                        <name>CMBL_ACCOUNT_NUMBER</name>
                        <javaObjectType>number</javaObjectType>
                        <value>$"root_cmbl_account_number"

$V(accountNumber,$E(("00000" + ($"root_cmbl_account_number" % 100000)).substring(("00000" + ($"root_cmbl_account_number" % 100000)).length - 5)))</value>
                    </messageElement>
                    <messageElement>
                        <name>CMBL_RECORD_TYPE</name>
                        <javaObjectType>string</javaObjectType>
                        <value>$"root_cmbl_record_type"</value>
                    </messageElement>
                    <messageElement>
                        <name>CMBL_CURRENCY_CODE</name>
                        <javaObjectType>string</javaObjectType>
                        <value>$"root_cmbl_currency_code"

$V(BRx_BalanceCurrency,$"root_cmbl_currency_code"{:4:3}&lt;CurrencyMappingBrToISO&gt;)
</value>
                    </messageElement>
                    <messageElement>
                        <name>CMBL_CURRENCY_CODE_9</name>
