                    <value>$E(&lt;script=
function ArrayToString(a,b,c,d,e,f) {
  	return '' +a + (b ? ',' + b : '') + (c ? ',' + c : '') + (d ? ',' + d : '') + (e ? ',' + e : '') + (f ? ',' + f : '');
};
&gt;)

$E(&lt;script=
function getRelationshipCode(a,b) {
	if(a== "" &amp;&amp; b== "")
		return 73;
	else if(a!= "" &amp;&amp; b== "")
		return 28;
	else if(a== "" &amp;&amp; b!= "")
		return 29;
	else
    	return 54;
};

function GetStatusCodes(A,B) {
  if (A==""){
  A="false";
  }
  if (B==""){
  B="false";
  }
  if (A == "true" &amp;&amp; B == "true") {
    return '00';
  } else if (A == "true" &amp;&amp; B == "false") {
    return '21';
  } else if (A == "false" &amp;&amp; B == "true") {
    return '30';
  } else if (A == "false" &amp;&amp; B == "false") {
    return '14';
  }
}

function isCanadaClient(clientIdentifier) {

	if(clientIdentifier=="092"){
     return true;
    }
 return false;
}

&gt;)</value>
