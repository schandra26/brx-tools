                <messageElement>
                    <name>root</name>
                    <value/>
                    <messageElement>
                        <name>repeating_fields</name>
                        <value/>
                        <messageElement>
                            <name>amount</name>
                            <repeats>true</repeats>
                            <repeatsMax>$"BRx_TransactionAmountDeconstruct_Count"</repeatsMax>
                            <value>$?($"BRx_TransactionAmountType_$s"{Valid:&lt;amount_type&gt;} != "",
	$V(TransactionAmountType_concat,$[$"TransactionAmountType_concat"|]$"BRx_TransactionAmountType_$s"&lt;amount_type&gt;)
		$?($"BRx_TransactionAmountValue_$s"{::1} == "-",
			$V(amountSign,-),
			$V(amountSign,+)
		)
	$V(TransactionAmountSignValue_concat,$[$"TransactionAmountSignValue_concat"|]$"amountSign")
	$V(TransactionAmountValue_concat,$[$"TransactionAmountValue_concat"|]$"BRx_TransactionAmountValue_$s"{Remove:-,+})
	$V(TransactionCurrencyValue_concat,$[$"TransactionCurrencyValue_concat"|]$"BRx_TransactionAmountCurrency_$s")
,)

</value>
                        </messageElement>
                        <messageElement>
                            <name>fees</name>
                            <repeats>true</repeats>
                            <repeatsMax>$"BRx_TransactionFeeDeconstruct_Count"</repeatsMax>
                            <value>$?($"BRx_TransactionFeeType_$s" == "WithholdingTax" || $"BRx_TransactionFeeType_$s" == "AdditionalWithholdingTax",
	$?($"BRx_TransactionNarrativeValue_TaxPoolCode" != "",
		$V(TransactionFeeTypeTaxPoolCode,$[$"BRx_TransactionFeeType_$s"$"BRx_TransactionNarrativeValue_TaxPoolCode"]),
		$V(TransactionFeeTypeTaxPoolCode,$"BRx_TransactionFeeType_$s")
	)
	
	$V(TransactionAmountType_concat,$[$"TransactionAmountType_concat"|]$"TransactionFeeTypeTaxPoolCode"&lt;tax_type&gt;)
		$?($"BRx_TransactionFeeValue_$s"{::1} == "-",
			$V(amountSign,-),
			$V(amountSign,+)
		)
$V(TransactionAmountSignValue_concat,$[$"TransactionAmountSignValue_concat"|]$"amountSign")
$V(TransactionAmountValue_concat,$[$"TransactionAmountValue_concat"|]$"BRx_TransactionFeeValue_$s"{Remove:-,+})
,)

$?($"BRx_TransactionFeeType_$s"{Valid:&lt;fee_type&gt;} != "",
	$V(TransactionAmountType_concat,$[$"TransactionAmountType_concat"|]$"BRx_TransactionFeeType_$s"&lt;fee_type&gt;)
		$?($"BRx_TransactionFeeValue_$s"{::1} == "-",
			$V(amountSign,-),
			$V(amountSign,+)
		)
$V(TransactionAmountSignValue_concat,$[$"TransactionAmountSignValue_concat"|]$"amountSign")
$V(TransactionAmountValue_concat,$[$"TransactionAmountValue_concat"|]$"BRx_TransactionFeeValue_$s"{Remove:-,+})
,)
</value>
                        </messageElement>
                    </messageElement>
                    <messageElement>
                        <name>astrid_payment_projections</name>
                        <instruction>sqlInsert</instruction>
